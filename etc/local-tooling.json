{
  "project": "project-laravel",
  "running": [
    "api"
  ],
  "gate": [
    "./bin/.build-full"
  ],
  "outputs": [
    "public/build"
  ],
  "runtime_probes": [
    [
      "exec",
      "-T",
      "api",
      "php",
      "-r",
      "echo json_encode([PHP_VERSION, get_loaded_extensions(), ini_get_all(null, false)]);"
    ]
  ],
  "directories": [
    "var/cache/laravel",
    "var/cache/phpunit"
  ],
  "build_prepare": [
    "./bin/.build-prepare"
  ],
  "extra_images": [
    "build",
    "runtime"
  ],
  "images": [
    "api",
    "server",
    "build",
    "runtime"
  ]
}
