#!/usr/bin/env sh
set -eu

mkdir -p var/cache/laravel var/cache/phpunit
cd "$(dirname "$0")/.."
image=$(./bin/runtime image-name build)
docker build --pull --provenance=false --file etc/docker/build/Dockerfile --tag "$image" .
# Compatibility entrypoint; Pest is the repository's canonical runner.
./bin/runtime docker run --rm \
    --user "$(id -u):$(id -g)" \
    --env APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA= \
    --env "APP_NAME=Fight Laravel Starter" \
    --env VIEW_COMPILED_PATH=/app/var/cache/laravel/views \
    --env CACHE_STORE=file \
    --env CACHE_FILE_PATH=/app/var/cache/laravel/data \
    --volume "$(pwd):/app" --workdir /app "$image" php vendor/bin/pest "$@"
