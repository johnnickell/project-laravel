<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="FightLaravel">
    <description>Fight Laravel repository coding standard</description>

    <file>app</file>
    <file>config</file>
    <file>database</file>
    <file>routes</file>
    <file>scripts</file>
    <file>tests</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/var/*</exclude-pattern>

    <rule ref="PSR12">
        <exclude name="Generic.Files.LineLength" />
        <!-- Laravel Pint deliberately uses PHPUnit snake-case methods and compact fixtures. -->
        <exclude name="PSR1.Classes.ClassDeclaration.MultipleClasses" />
        <exclude name="PSR1.Files.SideEffects.FoundWithSymbols" />
        <exclude name="PSR1.Methods.CamelCapsMethodName.NotCamelCaps" />
        <exclude name="PSR12.Classes.ClassInstantiation.MissingParentheses" />
        <exclude name="PSR12.ControlStructures.ControlStructureSpacing" />
        <exclude name="PSR12.Files.FileHeader.SpacingAfterDeclareBlock" />
        <exclude name="PSR12.Operators.OperatorSpacing" />
        <exclude name="Squiz.Functions.MultiLineFunctionDeclaration.BraceOnSameLine" />
        <exclude name="Squiz.WhiteSpace.ScopeClosingBrace.ContentBefore" />
    </rule>
</ruleset>
