{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "johnnickell/project-laravel",
    "type": "project",
    "description": "Public Laravel application composition for Fight libraries.",
    "keywords": ["fight", "laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "johnnickell/fight-access-control": "dev-develop",
        "johnnickell/fight-common": "dev-develop#4a798b1db8fdb5e4af7d0ba8c98a88ac53c50c16 as 1.2.0-dev",
        "guzzlehttp/guzzle": "^8.0",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0",
        "symfony/filesystem": "^7.4",
        "symfony/process": "^8.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/johnnickell/fight-access-control"
        },
        {
            "type": "vcs",
            "url": "https://github.com/johnnickell/fight-common"
        }
    ],
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php scripts/artisan key:generate",
            "@php scripts/artisan migrate --force",
            "npm --prefix client install --ignore-scripts",
            "npm --prefix client run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php scripts/artisan dev"
        ],
        "test": [
            "@php scripts/artisan config:clear --ansi @no_additional_args",
            "@php scripts/artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php scripts/artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php scripts/artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php scripts/artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php scripts/artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
